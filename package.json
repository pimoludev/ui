{
  "name": "ui",
  "version": "0.1.0-beta.3.1",
  "description": "Pimolu UI monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pimoludev/ui.git"
  },
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev:playground": "pnpm build:packages && pnpm --dir apps/playground dev",
    "build:playground": "pnpm --dir apps/playground build",

    "dev:examples:nextjs": "pnpm build:packages && pnpm --dir examples/nextjs dev",
    
    "dev:website": "pnpm build:packages && pnpm --dir apps/website dev",
    "build:website": "pnpm build:all && pnpm --dir apps/website build",
    "start:website": "pnpm --dir apps/website exec next start",

    "build": "node packages/design-tokens/scripts/build.mjs",
    "test": "node --test packages/design-tokens/tests/*.test.mjs",
    "playground dev": "pnpm --dir apps/playground dev",
    "test:react": "pnpm --dir registry/react test",
    "test:watch": "pnpm --dir registry/react test:watch",
    "build:all": "pnpm build && pnpm --dir packages/themes build:default && pnpm --dir packages/themes build:presets && pnpm --dir packages/themes build:visuals && pnpm build:web-styles && pnpm build:packages",
    "build:packages": "pnpm --dir packages/core build && pnpm --dir registry/react build",
    "release:plan": "node .agents/skills/release-manager/scripts/release-plan.mjs",
    "release:pack-check": "node .agents/skills/release-manager/scripts/pack-check.mjs",
    "test:themes": "pnpm --dir packages/themes test",
    "build:web-styles": "pnpm --dir packages/web-styles build:css",
    "test:web-styles": "pnpm --dir packages/web-styles test:css",
    "typecheck": "pnpm --dir apps/playground exec tsc -p ../../tsconfig.json",
    "lint": "pnpm --dir apps/playground run lint",
    "audit:themes": "node .agents/skills/theme-integrity-audit/scripts/theme-integrity.mjs",
    "audit:themes:strict": "node .agents/skills/theme-integrity-audit/scripts/theme-integrity.mjs --strict",
    "skills:check": "node .agents/skills/pimolu-orchestrator/scripts/list-skills.mjs",
    "verify:quick": "pnpm build:all && pnpm typecheck && pnpm audit:themes && pnpm test && pnpm test:themes && pnpm test:react && pnpm test:web-styles",
    "verify": "pnpm verify:quick && pnpm lint && pnpm skills:check && pnpm --dir apps/playground run build",
    "check": "pnpm verify && pnpm --dir examples/nextjs build",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.14.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
