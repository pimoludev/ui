{
  "name": "@pimolu/website",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "docs:generate": "node --experimental-strip-types scripts/build-docs.mjs",
    "dev": "pnpm docs:generate && next dev -p 3001",
    "build": "pnpm docs:generate && next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "pnpm docs:generate && next typegen && tsc --noEmit",
    "test": "pnpm docs:generate && node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "previews:capture": "node scripts/capture-previews.mjs",
    "audit:a11y": "node scripts/audit-accessibility.mjs"
  },
  "dependencies": {
    "@pimolu/design-tokens": "workspace:*",
    "@pimolu/react": "workspace:*",
    "@pimolu/themes": "workspace:*",
    "@pimolu/web-styles": "workspace:*",
    "motion": "^12.0.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.14.0"
}
