{
  "name": "@pimolu/core",
  "version": "0.1.0-beta.5",
  "description": "Framework-agnostic Pimolu UI class variant utilities.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pimoludev/ui.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
