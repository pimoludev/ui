{
  "name": "@pimolu/themes",
  "version": "0.1.0-beta.2",
  "description": "Pimolu colour themes, style presets and visual token data.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pimoludev/ui.git",
    "directory": "packages/themes"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": [
    "dist",
    "style-*.css",
    "src/presets",
    "src/visual"
  ],
  "scripts": {
    "build:presets": "node scripts/build-presets.mjs",
    "build:visuals": "node scripts/build-visuals.mjs",
    "build:default": "node scripts/build-default.mjs",
    "prepack": "pnpm build:default && pnpm build:presets && pnpm build:visuals",
    "test": "node --test"
  },
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./presets.css": "./style-presets.css",
    "./themes.json": "./dist/themes.json",
    "./presets": {
        "types": "./dist/presets.d.ts",
        "default": "./dist/presets.js"
      },
    "./visuals": {
        "types": "./dist/visuals.d.ts",
        "default": "./dist/visuals.js"
      }

  },
  "dependencies": {
    "@pimolu/design-tokens": "0.1.0-beta.2"
  }
}
